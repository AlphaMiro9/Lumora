<Window x:Class="Lumora.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Lumora" Icon="pack://application:,,,/Assets/lumora.ico" Width="1320" Height="820" MinWidth="760" MinHeight="480"
        FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen">
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.Find}" Executed="OnFocusSearch" />
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+L" Command="{x:Static ApplicationCommands.Find}" />
    </Window.InputBindings>

    <DockPanel>
        <Border x:Name="Bar" DockPanel.Dock="Top" Background="#0B7A87" Padding="10,8">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Click="OnStart" ToolTip="Lumora-Startseite" AutomationProperties.Name="Lumora-Startseite"
                            Style="{StaticResource TextBtn}" FontSize="20" FontWeight="Bold" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/lumora.ico" Width="26" Height="26" Margin="0,0,8,0" />
                            <TextBlock Text="Lumora" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="BackButton" Content="&#xE72B;" ToolTip="Zurück (Alt+Pfeil links)" Click="OnBack" AutomationProperties.Name="Zurück" Style="{StaticResource IconBtn}" />
                    <Button x:Name="ForwardButton" Content="&#xE72A;" ToolTip="Vor" Click="OnForward" AutomationProperties.Name="Vor" Style="{StaticResource IconBtn}" />
                    <Button Content="&#xE72C;" ToolTip="Neu laden (F5)" Click="OnReload" AutomationProperties.Name="Neu laden" Style="{StaticResource IconBtn}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0,0,0">
                    <Button x:Name="FavButton" Content="&#xE734;" ToolTip="Zu Favoriten hinzufügen" Click="OnFavorite" IsEnabled="False"
                            AutomationProperties.Name="Video zu Favoriten" Style="{StaticResource IconBtn}" />
                    <Button Content="Entdecken" Click="OnDiscover" Style="{StaticResource TextBtn}" AutomationProperties.Name="YouTube entdecken" />
                    <Button Content="Abos" Click="OnSubscriptions" Style="{StaticResource TextBtn}" AutomationProperties.Name="Abos öffnen" />
                    <Button Content="Bibliothek" Click="OnLibrary" Style="{StaticResource TextBtn}" AutomationProperties.Name="Bibliothek öffnen" />
                    <Button x:Name="SettingsButton" Content="&#xE713;" ToolTip="Einstellungen" Click="OnSettings" AutomationProperties.Name="Einstellungen" Style="{StaticResource IconBtn}">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="SettingsMenu">
                                <MenuItem x:Name="MiShorts" Header="Shorts ausblenden" IsCheckable="True" Click="OnSettingChanged" />
                                <MenuItem x:Name="MiComments" Header="Kommentare ausblenden" IsCheckable="True" Click="OnSettingChanged" />
                                <MenuItem x:Name="MiFocus" Header="Fokus-Modus (keine Vorschläge neben dem Video)" IsCheckable="True" Click="OnSettingChanged" />
                                <Separator />
                                <MenuItem x:Name="MiOwn" Header="Eigener Player (Videos in Lumora abspielen)" IsCheckable="True" Click="OnSettingChanged" />
                                <MenuItem x:Name="MiSb" Header="Sponsor-Segmente überspringen (SponsorBlock)" IsCheckable="True" Click="OnSettingChanged" />
                                <Separator />
                                <MenuItem x:Name="MiAutoUpdate" Header="Beim Start nach Updates suchen" IsCheckable="True" Click="OnSettingChanged" />
                                <MenuItem Header="Jetzt nach Updates suchen …" Click="OnCheckUpdate" />
                                <MenuItem Header="Protokoll-Ordner öffnen" Click="OnOpenLog" />
                                <Separator />
                                <MenuItem Header="Design">
                                    <MenuItem x:Name="MiAuto" Header="Wie Windows" IsCheckable="True" Tag="auto" Click="OnSchemeChanged" />
                                    <MenuItem x:Name="MiLight" Header="Hell" IsCheckable="True" Tag="light" Click="OnSchemeChanged" />
                                    <MenuItem x:Name="MiDark" Header="Dunkel" IsCheckable="True" Tag="dark" Click="OnSchemeChanged" />
                                </MenuItem>
                                <MenuItem Header="Farbe">
                                    <MenuItem Header="Türkis" Tag="#0B7A87" Click="OnAccentChanged" />
                                    <MenuItem Header="Violett" Tag="#6D4AFF" Click="OnAccentChanged" />
                                    <MenuItem Header="Orange" Tag="#C2570C" Click="OnAccentChanged" />
                                    <MenuItem Header="Grün" Tag="#2E7D32" Click="OnAccentChanged" />
                                    <MenuItem Header="Rot" Tag="#B3261E" Click="OnAccentChanged" />
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
                <Grid Margin="14,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" Grid.Column="0" Height="34" MaxWidth="720" MaxLength="200" FontSize="15"
                             VerticalContentAlignment="Center" Padding="8,0" KeyDown="OnSearchKeyDown"
                             AutomationProperties.Name="YouTube durchsuchen" ToolTip="Suchen und Enter drücken (Strg+L)" />
                    <Button Grid.Column="1" Content="&#xE721;" Click="OnSearch" ToolTip="Suchen" Margin="6,0,0,0" AutomationProperties.Name="Suchen" Style="{StaticResource IconBtn}" />
                </Grid>
            </DockPanel>
        </Border>
        <Border x:Name="UpdateBar" DockPanel.Dock="Top" Background="#F59E0B" Padding="12,6" Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Später" Click="OnDismissUpdate" Style="{StaticResource TextBtn}" Foreground="#14232A" />
                <Button x:Name="UpdateInstallButton" DockPanel.Dock="Right" Content="Jetzt aktualisieren" Click="OnInstallUpdate"
                        Style="{StaticResource TextBtn}" Foreground="#14232A" FontWeight="Bold" />
                <TextBlock x:Name="UpdateText" Foreground="#14232A" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
        </Border>
        <Grid>
            <wv2:WebView2 x:Name="Web" AutomationProperties.Name="Inhalt" />
            <TextBlock x:Name="ErrorText" Visibility="Collapsed" TextWrapping="Wrap" Margin="40" MaxWidth="640"
                       HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.LiveSetting="Assertive" />
        </Grid>
    </DockPanel>
</Window>
